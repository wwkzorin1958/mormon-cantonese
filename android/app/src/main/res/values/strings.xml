    <!-- Battery -->
    <string name="battery_title">讓播放不被系統中止</string>
    <string name="battery_explain">Android 會在鎖屏後暫停背景程式。允許本程式忽略電池優化，鎖屏後仍可繼續播放。</string>
    <string name="battery_allow">允許背景播放</string>
    <string name="battery_allowed">已允許背景播放</string>
    <string name="battery_guide_title">各品牌額外設定</string>
    <string name="battery_guide_generic">在「設定 → 應用程式 → 摩爾門經」中，允許自啟動與背景活動。</string>
    <string name="battery_guide_xiaomi">小米 / Redmi：設定 → 應用程式 → 摩爾門經 → 自啟動（開啟）；省電策略設為「無限制」。</string>
    <string name="battery_guide_huawei">華為 / 榮耀：設定 → 電池 → 應用程式啟動管理 → 摩爾門經 → 手動管理，全部開啟。</string>
    <string name="battery_guide_oppo">OPPO / realme：設定 → 電池 → 應用程式耗電管理 → 摩爾門經 → 允許背景執行。</string>
    <string name="battery_guide_vivo">vivo：設定 → 電池 → 背景耗電管理 → 摩爾門經 → 允許。</string>
    <string name="battery_guide_samsung">Samsung：設定 → 電池 → 背景用量限制 → 將摩爾門經加入「永不休眠的應用程式」。</string>

    <!-- First run -->
